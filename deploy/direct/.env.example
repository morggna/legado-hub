# Copy to .env, then edit before starting. No fixed password is shipped.
PUID=1000
PGID=1000
TZ=Asia/Shanghai
LEGADOHUB_ADMIN_USERNAME=admin
# Empty means a generated first-start password is printed once in container logs.
LEGADOHUB_ADMIN_PASSWORD=
LEGADOHUB_ALLOWED_HOSTS=127.0.0.1,localhost
LEGADOHUB_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
LEGADOHUB_TRUSTED_PROXIES=127.0.0.1/32
